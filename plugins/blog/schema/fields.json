    "status": "string",
    "locale": "string",
    "visibility": "string",
    "author_id": "integer",
    "featured_media_id": "media",
    "seo_title": "string",
    "meta_description": "text",
    "canonical_url": "string",
    "robots": "string",
    "open_graph": "json",
    "structured_data": "json",
    "featured": "boolean",
    "pinned": "boolean",
    "position": "integer",
    "publish_at": "datetime",
    "unpublish_at": "datetime"
  }
}

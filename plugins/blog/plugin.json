{
  "schemaVersion": 1,
  "id": "blog",
  "name": "Blog",
  "version": "1.0.0",
  "reaCmsVersion": "^1.0",
  "description": "Reference publishing plugin for Rea CMS.",
  "author": "Rea CMS",
  "navigation": {"label": "Blogs", "path": "/cms/blog"},
  "tables": [
    "plugin_blog_posts",
    "plugin_blog_categories",
    "plugin_blog_post_categories",
    "plugin_blog_revisions"
  ],
  "permissions": [
    "blog.posts.view",
    "blog.posts.create",
    "blog.posts.update",
    "blog.posts.delete",
    "blog.posts.publish",
    "blog.settings.manage"
  ],
  "api": {
    "resource": "blog",
    "formats": ["json", "html", "txt"],
    "defaultPolicy": "same-origin",
    "fields": {
      "id": {"type":"integer","label":"Post ID","description":"Unique numeric identifier for the blog post."},
      "title": {"type":"string","label":"Title","description":"Published blog post title."},
      "slug": {"type":"string","label":"Slug","description":"URL-safe blog post slug."},
      "excerpt": {"type":"text","label":"Excerpt","description":"Short summary of the blog post."},
      "content": {"type":"html","label":"Content","description":"Sanitized rich-text blog post content."},
      "locale": {"type":"string","label":"Locale","description":"Content locale code."},
      "publishedAt": {"type":"datetime","label":"Published date","description":"Publication timestamp in ISO 8601 format."}
    }
  }
}

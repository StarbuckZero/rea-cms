{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rea-cms.local/schemas/plugin-manifest-v1.json",
  "title": "Rea CMS declarative plugin manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "reaCmsVersion", "description", "tables", "permissions"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,31}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 191},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"},
    "reaCmsVersion": {"type": "string", "pattern": "^\\^[0-9]+\\.[0-9]+$"},
    "description": {"type": "string", "maxLength": 1000},
    "author": {"type": "string", "minLength": 1, "maxLength": 191},
    "tables": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "permissions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource", "formats", "defaultPolicy"],
      "properties": {
        "resource": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,31}$"},
        "formats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["json", "html", "txt"]}
        },
        "defaultPolicy": {"enum": ["public", "same-origin", "authenticated"]}
      }
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "path"],
      "properties": {
        "label": {"type": "string", "minLength": 1, "maxLength": 64},
        "path": {"type": "string", "pattern": "^/cms/[a-z][a-z0-9_-]{1,31}$"}
      }
    }
  }
}

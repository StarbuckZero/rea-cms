<?xml version="1.0"?>
<ruleset name="Rea CMS">
    <description>Rea CMS coding standard.</description>

    <file>app</file>
    <file>bin</file>
    <file>config</file>
    <file>tests</file>

    <exclude-pattern>vendor/*</exclude-pattern>

    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="PSR12"/>
</ruleset>


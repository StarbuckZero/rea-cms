# Copy this file to .env for local development. Never commit .env.
APP_ENV=development
APP_DEBUG=true
APP_URL=http://rea-cms.test
APP_TIMEZONE=UTC

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rea_cms_dev
DB_USERNAME=rea_cms_dev
DB_PASSWORD=replace-with-a-strong-local-password
DB_TABLE_PREFIX=rea_

LOG_LEVEL=debug
TRUSTED_PROXIES=

